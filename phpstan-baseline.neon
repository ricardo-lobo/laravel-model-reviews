parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:author\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/ReviewFactory.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:questions\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/ReviewFactory.php

		-
			message: '#^Trait RicardoLobo\\LaravelModelReviews\\Traits\\HasReviews is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/Traits/HasReviews.php
