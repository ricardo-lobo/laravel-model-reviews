includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
        - database
    # config/ is deliberately not analysed. Larastan resolves the "config
    # directory" via config_path(), which in a package context points at
    # testbench's app, so every env() call in this package's own config file is
    # reported as being outside the config directory.
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true

